# ==============================================================================
# PROEDGE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 
# DO NOT COMMIT REAL SECRETS OR KEYS TO THIS FILE.
# Create a copy of this file named `.env.local` for local development.

# ------------------------------------------------------------------------------
# 1. Public Variables (Client & Server)
# ------------------------------------------------------------------------------
# The Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co

# The Supabase Anon/Public Key (Safe to expose to the client bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The canonical URL of the application (used for SEO, sitemaps, open-graph)
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Server-Only Variables (DO NOT PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# No server-only secrets are currently required by the application backend.
# If adding integrations (e.g. Stripe, SendGrid), add their secrets here.

# ------------------------------------------------------------------------------
# 3. Local E2E Testing Variables (Playwright)
# ------------------------------------------------------------------------------
# Credentials for an existing Supabase admin account used exclusively 
# during E2E cache invalidation tests. 
# Do NOT use a production admin account for local testing.
ADMIN_EMAIL=test-admin@example.com
ADMIN_PASSWORD=your_secure_test_password
